{
  "name": "@swarnim/hermes",
  "description": "Type safe message bus, and RPC style services. Powered by Redis Streams",
  "author": "Swarnim Walavalkar <swarnim.walavalkar@gmail.com> (https://swarnimwalavalkar.com/)",
  "license": "MIT",
  "version": "1.1.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "release": "pnpm run build && changeset publish",
    "check": "tsc",
    "test": "vitest --run",
    "test:load": "vitest --run src/__tests__/load",
    "load:services": "tsx src/__tests__/load/services-load-test.ts",
    "load:events": "tsx src/__tests__/load/events-load-test.ts",
    "load:mixed": "tsx src/__tests__/load/mixed-load-test.ts",
    "load:all": "tsx src/__tests__/load/run-all-tests.ts",
    "load:monitor": "tsx src/__tests__/load/performance-monitor.ts",
    "docker:redis": "docker run -p 6379:6379 --rm --name hermes_test_redis redis:alpine"
  },
  "homepage": "https://github.com/SwarnimWalavalkar/hermes#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SwarnimWalavalkar/hermes.git"
  },
  "bugs": {
    "url": "https://github.com/SwarnimWalavalkar/hermes/issues",
    "email": "swarnim.walavalkar@gmail.com"
  },
  "keywords": [
    "async-task-queue",
    "redis-streams",
    "task-queue",
    "messaging",
    "streams",
    "pubsub",
    "redis",
    "queue",
    "rpc"
  ],
  "devDependencies": {
    "@types/node": "20.14.2",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "1.6.0",
    "autocannon": "^7.15.0",
    "@types/autocannon": "^4.1.4",
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "generic-pool": "3.9.0",
    "ioredis": "5.4.1",
    "zod": "3.23.8"
  }
}